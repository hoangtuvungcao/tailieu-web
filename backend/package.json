{
  "name": "@tailieu/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tài Liệu Sinh Viên REST API — Fastify + PostgreSQL + Redis + S3",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run copy:sql",
    "copy:sql": "tsx scripts/copy-sql.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx scripts/run-tests.ts",
    "test:watch": "tsx scripts/run-tests.ts --watch",
    "db:generate": "tsx ../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worker:converter": "tsx src/workers/converter/index.ts",
    "cleanup": "tsx src/workers/cleanup/index.ts",
    "test:setup": "tsx scripts/setup-test-db.ts",
    "maintenance:on": "tsx scripts/manage-maintenance.ts on",
    "maintenance:off": "tsx scripts/manage-maintenance.ts off",
    "maintenance:status": "tsx scripts/manage-maintenance.ts status",
    "purge:audit": "tsx scripts/manage-purge.ts audit",
    "purge:run": "tsx scripts/manage-purge.ts purge"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-storage": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "file-type": "^19.6.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
