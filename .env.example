# =============================================================================
# TAILIEU TTN — local development environment
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Each secret must be DIFFERENT. Reusing one secret across JWT/refresh/CSRF
# means a single leak compromises all three.
# =============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Public origin of the API. In production this is https://tailieu.5125121.com
# because the Pages Function proxies /api/* onto the tunnel. It is NEVER
# localhost in production.
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
POSTGRES_USER=tailieu
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=tailieu
POSTGRES_PORT=5432
DATABASE_URL=postgres://tailieu:change_me_dev_password@localhost:5432/tailieu
# Set to "true" when the DB requires TLS (managed Postgres, RDS, Neon...).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ----------------------------------------------------------------------------
# Redis — cache, rate limiting, job queue
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Object storage — SeaweedFS locally; any S3-compatible endpoint in production.
#
# MinIO deliberately not used: its community Docker images were removed in
# September 2026, quay.io stopped anonymous pulls, dl.min.io returns 410, the
# repo is archived, and CVE-2025-62506 is unpatched. SeaweedFS is Apache 2.0,
# maintained, and speaks the same S3 API, so this is a config swap only.
# ----------------------------------------------------------------------------
S3_PORT=8333
SEAWEED_MASTER_PORT=9333
SEAWEED_FILER_PORT=8888
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=tailieu_dev_access
S3_SECRET_KEY=change_me_storage_secret
S3_BUCKET=tailieu-documents
S3_STAGING_BUCKET=tailieu-staging
S3_REGION=us-east-1
# SeaweedFS and MinIO need path-style addressing; Cloudflare R2 needs
# virtual-hosted (false). Getting this wrong produces signature errors.
S3_FORCE_PATH_STYLE=true
# Lifetime of a download URL. Keep it short — it is a bearer credential.
S3_SIGNED_URL_TTL_SECONDS=120

# ----------------------------------------------------------------------------
# Auth secrets — all three MUST be different
# ----------------------------------------------------------------------------
JWT_SECRET=replace_with_48_random_bytes_base64url
JWT_REFRESH_SECRET=replace_with_a_different_48_random_bytes
CSRF_SECRET=replace_with_a_third_different_48_random_bytes
JWT_ISSUER=tailieu-ttn
JWT_AUDIENCE=tailieu-ttn-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
# Two tabs refreshing at once race on the same token. Without a grace window
# the honest second tab looks like refresh-token theft and logs the user out.
REFRESH_GRACE_MS=10000

# Argon2id pepper. NOT stored in the hash — losing this invalidates every
# password in the database. Back it up separately from DB backups.
ARGON2_PEPPER=replace_with_a_fourth_different_secret
# Optional Sentry-style DSN; leave blank to disable error reporting.
SENTRY_DSN=

# ----------------------------------------------------------------------------
# CORS — only consulted by the browser in local dev. In production the Pages
# Function makes the API same-origin, so this list is a defence-in-depth
# allowlist, not the primary control. NEVER use "*" here.
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
FRONTEND_URL=https://tailieu-ttn.pages.dev
COOKIE_DOMAIN=

# ----------------------------------------------------------------------------
# Uploads
# ----------------------------------------------------------------------------
# Chunk size must stay well under Cloudflare's 100MB per-request body cap,
# because every chunk travels through the Pages Function proxy.
UPLOAD_CHUNK_SIZE_BYTES=8388608
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_FILES_PER_DOCUMENT=10
# Chunked upload sessions are abandoned often; reap them.
UPLOAD_SESSION_TTL_HOURS=24

# ----------------------------------------------------------------------------
# Rate limiting (requests per window)
# ----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_HOUR=100
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_DOWNLOAD_PER_HOUR=300

# ----------------------------------------------------------------------------
# Mail (Hỗ trợ Gmail / Google Workspace hoặc SMTP tùy chỉnh)
# - Để dùng Gmail gửi email xác nhận & khôi phục mật khẩu khi quên:
#   1. Bật xác minh 2 bước (2-Step Verification) trong tài khoản Google.
#   2. Truy cập: https://myaccount.google.com/apppasswords tạo "Mật khẩu ứng dụng" (16 ký tự).
#   3. Đặt MAIL_DRIVER=smtp
#   4. Đặt SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#   5. Điền SMTP_USER=email_cua_ban@gmail.com và SMTP_PASSWORD=mat_khau_ung_dung_16_ky_tu
# ----------------------------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM="TAILIEU TTN <no-reply@tailieu.5125121.com>"
MAIL_FILE_PATH=./tmp/mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# ----------------------------------------------------------------------------
# Google OAuth — designed for, not yet live. Leave blank to disable the route.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ----------------------------------------------------------------------------
# Virus scanning (optional)
# ----------------------------------------------------------------------------
# OFF by default: ClamAV keeps a ~1GB signature database in memory, which is a
# real cost on a laptop. While it is off, uploads are marked `skipped` and
# served immediately — the operator chose that.
#
# While it is ON, a file stays `pending` and is NOT downloadable until the scan
# returns clean. Infected files are failed and never served.
#
#   docker compose --profile scan up -d clamav
#
SCAN_ENABLED=false
CLAMAV_PORT=3310
CLAMAV_ADDRESS=127.0.0.1:3310
CLAMAV_TIMEOUT_MS=120000
# Files above this are marked `skipped_too_large` and NOT served — "we could not
# check it" is not the same as "it is safe". Matches ClamAV's StreamMaxLength.
SCAN_MAX_BYTES=104857600

# ----------------------------------------------------------------------------
# AI — provider abstraction. Ollama runs locally on the laptop, no API key.
# ----------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=http://localhost:11434
AI_MODEL=

# ----------------------------------------------------------------------------
# Seed accounts (development only — change before exposing anything publicly)
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@tailieu.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026
SEED_MODERATOR_EMAIL=moderator@tailieu.local
SEED_MODERATOR_PASSWORD=ChangeMe_Mod_2026
SEED_STUDENT_EMAIL=student@tailieu.local
SEED_STUDENT_PASSWORD=ChangeMe_Student_2026

# ----------------------------------------------------------------------------
# Cloudflare Tunnel — used by deployment tooling, not by the API at runtime.
# The tunnel hostname the Pages Function proxies to. Never a raw IP.
# ----------------------------------------------------------------------------
TUNNEL_HOSTNAME=api-internal.tailieu.5125121.com
CLOUDFLARE_PUBLIC_URL=https://tailieu.5125121.com
