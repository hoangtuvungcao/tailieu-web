# =============================================================================
# TAILIEU TTN — PRODUCTION environment
# =============================================================================
# This file is a TEMPLATE. It documents every production variable and the
# value it must take. Do NOT copy it to `.env.production` and commit it —
# instead create the real file on the server with `chmod 600`:
#
#   install -m 600 .env.production.example /etc/tailieu/api.env
#   $EDITOR /etc/tailieu/api.env
#
# Differences from development that matter:
#   - CORS_ORIGINS is the real single origin, never localhost, never "*"
#   - S3_FORCE_PATH_STYLE flips to false when moving from SeaweedFS to R2
#   - MAIL_DRIVER becomes smtp (console output is lost in production)
#   - LOG_LEVEL drops to info, DATABASE_SSL turns on for managed Postgres
# =============================================================================

NODE_ENV=production
API_PORT=4000
# The public origin. Same host as the frontend because the Pages Function
# proxies /api/* — so this is NOT localhost and must be https.
API_PUBLIC_URL=https://tailieu.5125121.com
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database — move off the laptop's Docker Postgres before real traffic
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tailieu
DATABASE_SSL=true
DATABASE_POOL_MAX=20

REDIS_URL=redis://:PASSWORD@HOST:6379

# ----------------------------------------------------------------------------
# Object storage
# SeaweedFS: S3_FORCE_PATH_STYLE=true, S3_ENDPOINT=http://seaweedfs:8333
# R2:    S3_FORCE_PATH_STYLE=false, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ----------------------------------------------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tailieu-documents
S3_STAGING_BUCKET=tailieu-staging
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=120

# ----------------------------------------------------------------------------
# Auth — regenerate all four. Never reuse the development values.
# ----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=
ARGON2_PEPPER=
JWT_ISSUER=tailieu-ttn
JWT_AUDIENCE=tailieu-ttn-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
REFRESH_GRACE_MS=10000

# ----------------------------------------------------------------------------
# CORS — exactly one origin. The API is same-origin behind the Pages Function,
# so anything else appearing here is a misconfiguration.
# ----------------------------------------------------------------------------
CORS_ORIGINS=https://tailieu.5125121.com
# Leave blank for a host-only cookie. Set to .5125121.com only if the API is
# ever served from a sibling subdomain.
COOKIE_DOMAIN=

# ----------------------------------------------------------------------------
# Uploads — chunk size must stay far below Cloudflare's 100MB request cap
# ----------------------------------------------------------------------------
UPLOAD_CHUNK_SIZE_BYTES=8388608
MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_FILES_PER_DOCUMENT=10
UPLOAD_SESSION_TTL_HOURS=24

# ----------------------------------------------------------------------------
# Rate limiting — tighten, do not loosen, relative to development
# ----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_HOUR=100
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_DOWNLOAD_PER_HOUR=300

# ----------------------------------------------------------------------------
# Mail — console driver silently discards mail in production. Use smtp.
# ----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM="TAILIEU TTN <no-reply@tailieu.5125121.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tailieu.5125121.com/api/v1/auth/google/callback

# ----------------------------------------------------------------------------
# Virus scanning
# ----------------------------------------------------------------------------
# Strongly recommended in production. A university platform receives malicious
# PDFs; magic-byte validation rejects the wrong *format*, not the wrong *intent*.
#
# While ON, a file stays pending and is NOT downloadable until the scan returns
# clean. If clamd is unreachable the worker refuses to start rather than
# accepting jobs it cannot process.
SCAN_ENABLED=true
CLAMAV_ADDRESS=127.0.0.1:3310
CLAMAV_TIMEOUT_MS=120000
SCAN_MAX_BYTES=104857600

AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=http://localhost:11434
AI_MODEL=

# ----------------------------------------------------------------------------
# Cloudflare
# The tunnel's INTERNAL hostname. Cloudflare DNS points this at the tunnel;
# the public domain is served by Pages. Both are needed by deployment tooling.
# ----------------------------------------------------------------------------
TUNNEL_HOSTNAME=api-internal.tailieu.5125121.com
CLOUDFLARE_PUBLIC_URL=https://tailieu.5125121.com
